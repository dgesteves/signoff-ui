{
  "name": "signoff-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:lib && pnpm registry:build && pnpm build:playground",
    "build:lib": "pnpm --filter signoff-ui build",
    "build:playground": "pnpm --filter playground build",
    "dev": "pnpm --filter signoff-ui build && pnpm --parallel --filter signoff-ui --filter playground dev",
    "registry:build": "pnpm registry:check && shadcn build registry.json --output examples/playground/public/r",
    "lint": "eslint . --max-warnings=0",
    "lint:registry": "eslint --config scripts/eslint.registry.config.mjs --max-warnings=0 packages/signoff-ui/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter signoff-ui test",
    "test:coverage": "pnpm --filter signoff-ui test:coverage",
    "test:site": "pnpm --filter playground test",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "media": "node scripts/capture-media.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/example-versions.mjs",
    "release": "pnpm build:lib && changeset publish",
    "registry:generate": "node scripts/registry.mjs",
    "registry:check": "node scripts/registry.mjs --check",
    "examples:check": "node scripts/example-versions.mjs --check",
    "a11y": "node scripts/a11y-audit.mjs",
    "size": "node scripts/size.mjs",
    "perf": "node scripts/perf.mjs",
    "smoke:nextjs": "node scripts/smoke-nextjs-minimal.mjs",
    "smoke:assistant-ui": "node scripts/smoke-assistant-ui.mjs",
    "smoke:coding-agent": "node scripts/smoke-coding-agent.mjs",
    "smoke:copilotkit": "node scripts/smoke-copilotkit.mjs",
    "smoke:playground": "node scripts/smoke-playground.mjs",
    "smoke:styles": "node scripts/smoke-styles.mjs",
    "smoke:fresh-install": "node scripts/smoke-fresh-install.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rolldown": "^1.2.13",
    "shadcn": "^4.21.4",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
