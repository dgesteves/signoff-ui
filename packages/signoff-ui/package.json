{
  "name": "signoff-ui",
  "version": "0.10.2",
  "description": "Review what your agent changed and approve what it may do: React components for multi-file diff review and tool approvals that return a result your agent acts on, for AI SDK 6 & 7, AG-UI and ACP agents, inside assistant-ui, AI Elements or your own chat.",
  "license": "MIT",
  "author": "Diogo Esteves (https://diogo-studio.com)",
  "homepage": "https://signoff-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgesteves/signoff-ui.git",
    "directory": "packages/signoff-ui"
  },
  "bugs": "https://github.com/dgesteves/signoff-ui/issues",
  "keywords": [
    "react",
    "diff-review",
    "code-review",
    "approval",
    "human-in-the-loop",
    "tool-approval",
    "ai-agents",
    "coding-agent",
    "ai-sdk",
    "ai-elements",
    "assistant-ui",
    "ag-ui",
    "langgraph",
    "acp",
    "agent-client-protocol",
    "claude-code",
    "codex",
    "agent-ui",
    "tool-calling",
    "approval-rules",
    "permissions",
    "diff",
    "hunk",
    "patch",
    "nextjs",
    "shadcn",
    "tailwindcss",
    "accessibility"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./ag-ui": {
      "types": "./dist/ag-ui.d.ts",
      "default": "./dist/ag-ui.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "default": "./dist/acp.js"
    },
    "./assistant-ui": {
      "types": "./dist/assistant-ui.d.ts",
      "default": "./dist/assistant-ui.js"
    },
    "./custom-markdown": {
      "types": "./dist/custom-markdown.d.ts",
      "default": "./dist/custom-markdown.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layered.css": "./dist/styles.layered.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./theme.css": "./dist/theme.css",
    "./theme.auto.css": "./dist/theme.auto.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs && node scripts/check-directives.mjs && node scripts/check-dist.mjs",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./styles.layered.css ./tailwind.css ./theme.css ./theme.auto.css",
    "prepack": "node scripts/npm-readme.mjs prepack",
    "postpack": "node scripts/npm-readme.mjs postpack"
  },
  "peerDependencies": {
    "@assistant-ui/react": ">=0.15.0 <1",
    "ai": "^6.0.0 || ^7.0.102",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "^1.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@ag-ui/client": "^1.0.3",
    "@ag-ui/core": "^1.0.3",
    "@agentclientprotocol/sdk": "^2.0.2",
    "@arethetypeswrong/cli": "^0.18.5",
    "@assistant-ui/react": "^0.15.27",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ai": "^7.0.143",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "7.8.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
