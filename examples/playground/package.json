{
  "name": "playground",
  "private": true,
  "type": "module",
  "scripts": {
    "index": "node --import ./scripts/ts-resolve.mjs scripts/ask-index.ts",
    "dev": "pnpm index && next dev --port 3100",
    "unshallow": "node scripts/unshallow.mjs",
    "build": "pnpm unshallow && pnpm index && next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/ts-resolve.mjs --test test/*.test.ts"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.3",
    "@ag-ui/core": "^1.0.3",
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/react": "^4.0.147",
    "@radix-ui/react-dialog": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.143",
    "cmdk": "^1.1.1",
    "geist": "^1.8.2",
    "next": "^16.4.2",
    "ondocs": "^0.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "7.8.1",
    "shiki": "^4.5.0",
    "signoff-ui": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
